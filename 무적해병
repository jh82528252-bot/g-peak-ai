# ==========================================
# 2. 시간대 및 계절별 수요·전력 피크 분석 함수
# ==========================================
def analyze_grid_status(hour, season, is_weekend=False):
    # 계절별 배터리 효율 및 전력 부하 가중치
    season_info = {
        "겨울": {"weight": 1.3, "reason": "저온 배터리 효율 저하(20~30% 감소) 및 히터 가동으로 충전량 급증"},
        "여름": {"weight": 1.2, "reason": "에어컨 냉방 부하 및 급속 충전 시 배터리 냉각 시스템 가동"},
        "봄": {"weight": 1.0, "reason": "배터리 최적 온도 유지 (낮 시간 태양광 잉여 전력 발생)"},
        "가을": {"weight": 1.0, "reason": "배터리 최적 온도 유지 (낮 시간 태양광 잉여 전력 발생)"}
    }
    
    # 2026년 개편 시간대별 부하 및 요금 기준
    if 18 <= hour < 21:
        load_level = "매우 혼잡 (최대부하 피크)"
        rate_status = "최고 요금 구간 (전력망 과부하 주의)"
    elif 8 <= hour < 18:
        load_level = "보통 (중간부하)"
        # 봄/가을 주말 낮 11~14시 특별 할인 반영
        if season in ["봄", "가을"] and is_weekend and 11 <= hour < 14:
            rate_status = "그린 에너지 특별 할인 (태양광 잉여전력 50% 할인)"
        else:
            rate_status = "중간 요금 구간"
    else:
        load_level = "여유 (경부하)"
        rate_status = "최저 요금 구간 (심야 할인)"

    return load_level, rate_status, season_info.get(season, season_info["봄"])

# ==========================================
# 3. AI 전력 부하 분산 및 충전소 추천 엔진
# ==========================================
def recommend_charging_plan(target_station_id, hour, season, is_weekend=False):
    # 선택한 충전소 찾기
    target = next((s for s in gyeongnam_stations if s["id"] == target_station_id), None)
    if not target:
        return "해당 충전소 ID를 찾을 수 없습니다."

    load_level, rate_status, s_data = analyze_grid_status(hour, season, is_weekend)
    
    # 현재 혼잡도 계산 (계절 가중치 반영)
    utilization = (target["current_users"] / target["chargers"]) * 100
    adjusted_load = min(100, round(utilization * s_data["weight"], 1))

    print(f"==================================================")
    print(f"⚡ [G-피크-AI] 경남 전기차 충전 부하 분석 리포트")
    print(f"==================================================")
    print(f"📍 선택 충전소 : [{target['city']}] {target['name']} ({target['type']})")
    print(f"🕒 분석 조건   : {season}철 / {hour}시 / {'주말' if is_weekend else '평일'}")
    print(f"📊 전력망 상태 : {load_level}")
    print(f"💰 적용 요금제 : {rate_status}")
    print(f"🌡️ 계절 변수   : {s_data['reason']}")
    print(f"🔌 예상 부하율 : {adjusted_load}% (현재 {target['current_users']}/{target['chargers']}대 이용 중)")
    print(f"--------------------------------------------------")

    # 부하 분산 유도 알고리즘 (부하율 80% 이상이거나 피크 시간대일 때 작동)
    if adjusted_load >= 80 or (18 <= hour < 21):
        print("🚨 [AI 경고] 현재 전력 피크 또는 충전소 혼잡도가 매우 높습니다!")
        
        # 같은 도시 내 여유 있는 대체 충전소 탐색
        alternatives = [
            s for s in gyeongnam_stations 
            if s["city"] == target["city"] and s["id"] != target["id"] 
            and (s["current_users"] / s["chargers"]) < 0.6
        ]
        
        if alternatives:
            alt = alternatives[0]
            print(f"💡 [분산 추천 1] 인근 한산한 '{alt['name']}' 이동을 권장합니다.")
            print(f"   👉 혜택: 지역화폐(누비전 등) 충전 인센티브 지급 & 대기시간 0분")
        
        if 18 <= hour < 21:
            print(f"💡 [분산 추천 2] 밤 22:00 이후 '심야 경부하 예약 충전' 전환을 권장합니다.")
            print(f"   👉 혜택: 최대부하 대비 충전 요금 대폭 절감 및 변압기 과부하 예방")
    else:
        print("✅ [AI 안내] 현재 전력망과 충전소가 여유롭습니다. 바로 충전을 진행하세요!")
    print(f"==================================================\n")

